ADMIN_PASSWORD=changeme
HOST=127.0.0.1
API_PORT=3001
WEB_PORT=80
HTTPS_PORT=443
# Set false for HTTP-only / IP installs (no TLS on :443). Installer: --http
HTTPS_ENABLED=true
WEB_HOST=0.0.0.0
SESSION_SECRET=change-this-secret-to-something-random
DATA_DIR=./data
# API structured logs (pino). fatal|error|warn|info|debug|trace
# LOG_LEVEL=info
# Log Prisma queries slower than N ms (unset = off)
# PRISMA_SLOW_MS=200
# Prometheus scrape token — use Authorization: Bearer only (no ?token= in URLs).
# If unset, metrics endpoints only accept loopback (127.0.0.1 / ::1).
# METRICS_TOKEN=
# Optional Sentry error tracking (API + daemon). Web build: VITE_SENTRY_DSN.
# SENTRY_DSN=
# VITE_SENTRY_DSN=
JAVA_PATH=/usr/lib/jvm/java-25-openjdk-amd64/bin/java
DOCKER_IMAGE=eclipse-temurin:25-jre-jammy
# Game container Docker json-file log rotation (daemon / node-agent)
# DOCKER_LOG_MAX_SIZE=10m
# DOCKER_LOG_MAX_FILE=3
# Game container Docker networks (daemon / data/daemon.env — panel forwards on remote install):
#   per_server — default: isolated bridge per server (multi-tenant / untrusted players); MySQL stays on shared bridge
#   shared     — flat `guartrix` bridge (requires ALLOW_SHARED_DOCKER_NETWORK=1 on daemon)
# DOCKER_NETWORK_MODE=per_server
# ALLOW_SHARED_DOCKER_NETWORK=0
# Extra host mounts: comma-separated allowed host path prefixes for server Docker binds.
# Default (when unset): /var/lib/guartrix/shared,/opt/guartrix/shared
# EXTRA_MOUNTS_ALLOW_PREFIX=/var/lib/guartrix/shared,/opt/guartrix/shared
MANAGE_FIREWALL=true
# Hostname players/panel use (domain preferred; IP goes in PUBLIC_IP)
PUBLIC_HOST=guartrix.com
PUBLIC_IP=203.0.113.10
# Full base URL for resource packs (Minecraft clients must reach this)
PUBLIC_BASE_URL=https://guartrix.com
# Set true when serving the panel over HTTPS with a trusted cert
SESSION_SECURE=true
# Required when SESSION_SECURE=true behind Cloudflare / the local HTTPS proxy
TRUST_PROXY=true
# Comma-separated peer IPs allowed to set X-Forwarded-For (default: localhost only).
# Use * only if every hop is a trusted edge. Example: 127.0.0.1,::1
# TRUSTED_PROXIES=127.0.0.1,::1,::ffff:127.0.0.1
# TRUSTED_PROXIES=* requires ALLOW_INSECURE_TRUST_PROXY=1 (XFF spoofing risk)
# ALLOW_INSECURE_TRUST_PROXY=0
# Cookie CSRF: mutating /api without Origin/Referer is rejected (Bearer exempt).
# Set 1 only for local curl debugging with session cookies.
# CSRF_ALLOW_MISSING_ORIGIN=0
# Cloudflare Origin cert (defaults to cert/guartrix.com.crt + .key if present)
# TLS_CERT_FILE=./cert/guartrix.com.crt
# TLS_KEY_FILE=./cert/guartrix.com.key
# Cloudflare DNS — auto-create Minecraft subdomains on server create
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_DOMAIN=guartrix.com
# Node daemon (also written to data/daemon.env by start-prod)
# Panel-only install: set 1 to skip the local daemon/node (use remote nodes)
# SKIP_LOCAL_DAEMON=0
DAEMON_HOST=127.0.0.1
DAEMON_PORT=8081
# Public HTTPS hostname for the local daemon (prod-web Host proxy + SNI). Empty = disabled.
# DAEMON_PUBLIC_HOST=node1.guartrix.com
# DAEMON_PROXY_HOST=127.0.0.1
# DAEMON_PROXY_PORT=8081
# DAEMON_TLS_CERT_FILE=/etc/letsencrypt/live/node1.guartrix.com/fullchain.pem
# DAEMON_TLS_KEY_FILE=/etc/letsencrypt/live/node1.guartrix.com/privkey.pem
# sudo bash scripts/install-daemon-le-cert.sh  # issue/renew + grey-cloud DNS
# DNS-only host for password /download (avoids Cloudflare bot challenge on apex).
# DOWNLOAD_PUBLIC_HOST=download.guartrix.com
# DOWNLOAD_TLS_CERT_FILE=/etc/letsencrypt/live/download.guartrix.com/fullchain.pem
# DOWNLOAD_TLS_KEY_FILE=/etc/letsencrypt/live/download.guartrix.com/privkey.pem
# sudo bash scripts/install-download-le-cert.sh
# Email for Let's Encrypt helpers (daemon LE / download LE / license LE scripts)
# LETSENCRYPT_EMAIL=admin@example.com
# Optional: set explicitly, otherwise start-prod generates into data/daemon.env
# DAEMON_TOKEN=
# Written by the panel into data/daemon.env (do not invent):
# DAEMON_NODE_ID=
# Short-lived HS256 JWTs (HMAC with DAEMON_TOKEN). Defaults shown.
# DAEMON_JWT_TTL=900
# DAEMON_JWT_WS_TTL=3600
# Accept long-lived bearer only for old nodes (default false — JWT required)
# DAEMON_JWT_LEGACY=false
# Embedded SFTP server (per node) — FileZilla / WinSCP use this
SFTP_PORT=2022
SFTP_ENABLED=true
# Panel URL the daemon calls for SFTP password checks (local default is fine)
# PANEL_URL=http://127.0.0.1:3001
# Per-node MySQL (daemon manages Docker container guartrix-mysql)
MYSQL_PORT=3306
MYSQL_IMAGE=mysql:8.4
# MYSQL_ROOT_PASSWORD=  # auto-generated into data/daemon.env if unset
# MYSQL_PUBLIC_HOST=guartrix-mysql  # Docker network DNS for plugins (default)
# Panel Prisma database. Installer can use Docker (--mysql-docker) or an
# existing server (--mysql-external / DATABASE_URL). Create DB+user first if external.
MYSQL_HOST=127.0.0.1
MYSQL_DATABASE=guartrix_panel
MYSQL_USER=guartrix
MYSQL_PASSWORD=change-me
DATABASE_URL=mysql://guartrix:change-me@127.0.0.1:3306/guartrix_panel
# Optional Prisma MySQL pool knobs on the URL, e.g.:
# DATABASE_URL=mysql://user:pass@127.0.0.1:3306/guartrix_panel?connection_limit=10&pool_timeout=20
# Watchdog (scripts/monitor.sh) — started automatically by scripts/start.sh.
# Restarts daemon/API/web and Docker if they become unreachable. Never
# touches Minecraft server containers, and never stops them on a panel
# restart. Set NO_MONITOR=1 to disable (e.g. for local dev).
# NO_MONITOR=1
# MONITOR_INTERVAL=20
# MONITOR_MAX_RESTARTS=6
# MONITOR_BACKOFF=300
# Delay (ms) between starting each "start on boot" server, so a reboot
# doesn't start every JVM at once. 0 disables the stagger.
# BOOT_START_STAGGER_MS=20000

# Per-server disk usage cache TTL on the node (stale-while-revalidate, default 30000 ms).
# DISK_USAGE_CACHE_MS=30000

# How often the panel checks disk quotas for high-usage alerts (default 300000 = 5 min).
# DISK_WATCH_INTERVAL_MS=300000
# DISK_WATCH_PAGE_SIZE=100
# DISK_WATCH_CONCURRENCY=8
# SCHEDULER_TASK_BATCH=50
# SCHEDULER_BACKUP_BATCH=50
# ADMIN_STATUS_CACHE_MS=10000
# ADMIN_STATUS_NODE_CONCURRENCY=8
# Backup/restore busy lock TTL in Redis (multi-API); default 2h. Single-API uses memory.
# BACKUP_BUSY_TTL_MS=7200000
# Daemon /events bridge (fase 4): backoff + Redis single-primary when REDIS_URL set
# DAEMON_BRIDGE_RECONNECT_BASE_MS=1000
# DAEMON_BRIDGE_RECONNECT_MAX_MS=60000
# DAEMON_BRIDGE_RECONNECT_JITTER_MS=1000
# DAEMON_BRIDGE_CONNECT_STAGGER_MS=10000
# DAEMON_BRIDGE_LOCK_TTL_MS=15000
# DAEMON_BRIDGE_MODE=auto

# Short TTL for server-list FS meta (hasIcon / whitelistEnabled) to avoid N× sync reads (default 15000 ms).
# SERVER_LIST_FS_CACHE_MS=15000

# Open registration (default on). Set REGISTRATION_ENABLED=false for invite-only via Users.
# New accounts start with 0 servers / RAM / DBs — raise quotas when they buy a plan.
# REGISTRATION_ENABLED=true
GUARTRIX_REPO_URL=https://github.com/TomThermo/guartrix.git
DEFAULT_MAX_SERVERS=0
DEFAULT_MAX_MEMORY_MB=0
DEFAULT_MAX_DATABASES=0

# Optional SMTP for password-reset emails. Without SMTP, messages are written
# to data/mail-outbox/ for operators to deliver manually.
# MAIL_FROM=noreply@guartrix.com
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASS=

# Roles that must enable TOTP before mutating the panel (comma-separated).
# Example: ADMIN or ADMIN,OPERATOR. Empty = optional for everyone.
# TWO_FACTOR_REQUIRED_ROLES=ADMIN
# Local/dev only — allow default SESSION_SECRET / ADMIN_PASSWORD (API refuses otherwise)
# ALLOW_INSECURE_DEFAULTS=0

# Client API — max requests per minute per personal API key (default 120).
# API_KEY_RATE_LIMIT=120

# Application API (`gta_` machine keys) — rate limit per key (default 120).
# APPLICATION_API_RATE_LIMIT=120

# Authenticated cookie session /api rate limit (requests per minute per userId, default 600).
# API_SESSION_RATE_LIMIT=600
# Separate budget for dashboard poll GETs (default max(1800, 3× session limit)).
# API_SESSION_READ_RATE_LIMIT=1800

# Persist login / API-key / SFTP rate-limit counters across API restarts (default file).
# Set to memory for in-process only (faster; cleared on restart).
# Set to redis for multi-API shared counters (needs REDIS_URL).
# RATE_LIMIT_STORE=file

# Session store for panel logins (default file under data/sessions).
# For multi-API HA: share data/sessions via NFS, or set redis + REDIS_URL
# (requires optionalDependency ioredis: npm i ioredis -w @msm/api).
# SESSION_STORE=file
# REDIS_URL=redis://127.0.0.1:6379/0
# REDIS_ENABLED=1
# Scheduler leader lock TTL when Redis is enabled (default 15000).
# With Redis configured, scheduler lock acquisition fail-closed on Redis errors.
# SCHEDULER_LOCK_TTL_MS=15000
# BullMQ durable jobs when REDIS_URL is set (default on). Set 0 for in-process only.
# JOBS_BULLMQ=1
# Run BullMQ workers inside the API process (default on).
# JOBS_EMBEDDED=1
#
# Managed SaaS / multi-API HA: refuse boot unless Redis is connected, BullMQ is up,
# and SESSION_STORE=redis + RATE_LIMIT_STORE=redis. Alias: PANEL_HA=1.
# REQUIRE_REDIS_HA=0
#
# Node transfer: peer copy is always preferred. Panel tmpdisk staging is **off** by
# default (avoids IO cliffs). Set 1 only if nodes cannot reach each other.
# TRANSFER_ALLOW_PANEL_STAGING=0
#
# Aggregate Client API + cookie session budget per owning user (requests/min). 0=off.
# API_OWNER_RATE_LIMIT=1800

# prod-web.mjs: also send Content-Security-Policy-Report-Only with stricter
# style-src ('self' only, no unsafe-inline) so browsers log violations without
# breaking Bootstrap. Enforcing CSP still allows style-src unsafe-inline.
# CSP_REPORT_ONLY=0
# Extra script-src hosts/hashes (space-separated), e.g. Cloudflare extras.
# CSP_SCRIPT_SRC_EXTRA=
# Allow inline scripts (weakens XSS protection). Only if Cloudflare Email
# Obfuscation / Bot Fight Mode injects inline JS you cannot turn off.
# CSP_ALLOW_UNSAFE_INLINE_SCRIPT=0

# Release builds (esbuild-release.mjs): obfuscate api/daemon dist after minify.
# Default on. Set 0 to skip (debug / support builds).
# RELEASE_OBFUSCATE=1

# Mollie Payments — enable panel checkout + webhook provision.
# Get a key at https://www.mollie.com/ (test_… for sandbox, live_… for production).
# Webhook URL must be public: https://<PUBLIC_HOST>/api/public/billing/mollie
# MOLLIE_API_KEY=
# Optional: restrict webhook to Mollie egress IPs (comma or space separated)
# MOLLIE_WEBHOOK_IP_ALLOWLIST=
# Optional outbound JSON for your storefront / WHMCS bridge after paid/provisioned.
# BILLING_WEBHOOK_URL=

# CurseForge (optional) — enables Modpacks tab CurseForge search/install.
# Get a key at https://console.curseforge.com/
# CURSEFORGE_API_KEY=

# Licensing — panel client (validates against Guartrix public license API)
LICENSE_SERVER_URL=https://license.guartrix.com
# LICENSE_KEY=
# LICENSE_INSTALL_ID=
# Ed25519 public key (PEM) to verify signed /v1/validate responses.
# Same-host installs auto-load data/licenses/signing-public.pem if unset.
# LICENSE_VERIFY_PUBLIC_KEY=
# Emergency only: accept unsigned validate JSON (insecure — piracy risk)
# LICENSE_ALLOW_UNSIGNED=0
# Soft-valid window while license server is unreachable (default 12h)
# LICENSE_UNREACHABLE_GRACE_MS=43200000
# How often the panel re-checks the license server (default 10 minutes)
# LICENSE_VALIDATE_INTERVAL_MS=600000
# Activity alert after N consecutive validate failures (default 3)
# LICENSE_VALIDATE_FAIL_ALERTS=3

# Activity log — days of history to keep (0 = forever), pruned hourly.
# ACTIVITY_LOG_RETENTION_DAYS=90
# Alerts for critical events (crash, offline, node down, deletes, role changes).
# Discord webhooks get rich embeds; any other URL gets a generic JSON POST.
# ACTIVITY_WEBHOOK_URL=
# ALERT_EMAIL=ops@guartrix.com
# Comma-separated action keys to never alert on, e.g. auth.login-failed
# ACTIVITY_ALERT_MUTE=
# Web Push (PWA) for critical alerts — generate with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@example.com

# Optional offsite backup after each successful createBackup (shell via bash -lc).
# Placeholders: {path} {serverId} {backupId} {fileName}
# BACKUP_OFFSITE_CMD=rclone copy "{path}" b2:guartrix-backups/{serverId}/
# Encrypt new backups at rest (AES-256-GCM → .tar.gz.enc). Default key = SESSION_SECRET.
# BACKUP_ENCRYPTION=0
# Optional dedicated passphrase / 64-char hex / base64-32 key (preferred in production):
# BACKUP_ENCRYPTION_KEY=

# Password-gated release downloads: https://download.guartrix.com/download
# (or https://$PUBLIC_HOST/download when DOWNLOAD_PUBLIC_HOST is unset)
# npm run package:download  →  data/downloads/
# DOWNLOAD_PASSWORD=
# DOWNLOAD_ENABLED=0
# DOWNLOAD_DIR=./data/downloads
# DOWNLOAD_SESSION_TTL_SEC=604800
# DOWNLOAD_COOKIE_SECRET=

# Wiki screenshot capture (operator/docs host only — not used by panel runtime)
# GUARTRIX_SERVER_ID=
# GUARTRIX_DEMO_SERVER_NAME=server1
# GUARTRIX_TOTP_SECRET=
# GUARTRIX_TOTP=
# GUARTRIX_BASE_URL=https://guartrix.com
# GUARTRIX_TOTP_FROM_DB=1
