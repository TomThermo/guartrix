{
  "name": "guartrix",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:api & npm run dev:web; wait",
    "dev:api": "npm run dev -w @guartrix/api",
    "dev:web": "npm run dev -w @guartrix/web",
    "dev:daemon": "npm run dev -w @guartrix/daemon",
    "build": "npm run build -w @guartrix/shared && npm run build -w @guartrix/node-agent && npm run build -w @guartrix/daemon && npm run build -w @guartrix/api && npm run build -w @guartrix/web",
    "db:generate": "npm run db:generate -w @guartrix/api",
    "db:migrate": "npm run db:migrate -w @guartrix/api",
    "db:push": "npm run db:push -w @guartrix/api",
    "start": "npm run start -w @guartrix/api",
    "start:sh": "bash scripts/start.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:install": "playwright install chromium",
    "lint": "biome check . && node scripts/check-auth-crypto-imports.mjs",
    "lint:fix": "biome check --write .",
    "check:auth-imports": "node scripts/check-auth-crypto-imports.mjs",
    "check:boundaries": "depcruise --config .dependency-cruiser.cjs apps/web/src apps/api/src",
    "check:openapi": "node scripts/check-openapi-coverage.mjs && node scripts/sync-openapi-server-schemas.mjs --check",
    "check:size-budgets": "node scripts/check-file-size-budgets.mjs",
    "check:wiki-markdown": "node scripts/check-wiki-markdown.mjs",
    "check:enterprise": "npm run build -w @guartrix/shared && npm run lint && npm run check:boundaries && npm run check:openapi && npm run check:size-budgets && npm run check:wiki-markdown && npm run typecheck -w @guartrix/shared && npm run typecheck -w @guartrix/api && npm run typecheck -w @guartrix/web && npm run typecheck -w @guartrix/daemon",
    "sync:openapi-schemas": "node scripts/sync-openapi-server-schemas.mjs",
    "fa:subset": "node scripts/fa-subset-icons.mjs",
    "bundle:daemon": "node scripts/bundle-daemon-for-nodes.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.6",
    "@playwright/test": "^1.55.0",
    "@vitest/coverage-v8": "^3.2.7",
    "dependency-cruiser": "^16.10.4",
    "esbuild": "^0.25.0",
    "javascript-obfuscator": "^4.2.2",
    "typescript": "^5.8.2",
    "vitest": "^3.2.7"
  },
  "version": "1.4.35"
}
