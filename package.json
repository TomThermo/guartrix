{
  "name": "minecraft-server-manager",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:api & npm run dev:web; wait",
    "dev:api": "npm run dev -w @msm/api",
    "dev:web": "npm run dev -w @msm/web",
    "dev:daemon": "npm run dev -w @msm/daemon",
    "build": "npm run build -w @msm/shared && npm run build -w @msm/node-agent && npm run build -w @msm/daemon && npm run build -w @msm/api && npm run build -w @msm/web",
    "db:generate": "npm run db:generate -w @msm/api",
    "db:migrate": "npm run db:migrate -w @msm/api",
    "db:push": "npm run db:push -w @msm/api",
    "start": "npm run start -w @msm/api",
    "start:sh": "bash scripts/start.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "fa:subset": "node scripts/fa-subset-icons.mjs",
    "bundle:daemon": "node scripts/bundle-daemon-for-nodes.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.6",
    "@vitest/coverage-v8": "^3.2.7",
    "esbuild": "^0.25.0",
    "javascript-obfuscator": "^4.2.2",
    "typescript": "^5.8.2",
    "vitest": "^3.2.7"
  },
  "version": "1.4.11"
}
