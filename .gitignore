node_modules/
dist/
dist-release/
dist-download/
build/
.vite/
.DS_Store
*.log

# Local Cursor / GitHub Actions config — keep on disk, never publish on main.
.cursor/
.github/

# Secrets & local env
.env
.env.local
license.env
# Live license config is data/license.env (under data/, already ignored)
*.pem

# Operator-only license issuer — NEVER in this public panel repo.
# Lives as a sibling checkout (e.g. ../guartrix-license-server), not under apps/.
apps/license-server/
apps/license-server/**
**/guartrix-license-server/

# Operator promo docs (also under data/promo-docs/). Never commit if recreated at these paths.
docs/site/
scripts/docs-site.mjs

# Runtime / generated data (never commit)
data/
# Operator promo docs index (HTTPS :8443) also lives under data/promo-docs/ — never GitHub.
# Keep env templates next to live files (data/*.env.example is tracked)
!data/
data/**
!data/*.example
!data/**/*.example
cert/

# Legacy / local DB files
*.db
*.db-journal
apps/api/prisma/*.db
apps/api/prisma/*.db-journal
dev.db.sqlite-backup
coverage/
