# Guartrix local / remote daemon — template for data/daemon.env
# On a full panel install this file is generated by start scripts.
# For a standalone remote node, prefer: bash scripts/install-daemon.sh
#   (or the panel “Add node” wizard), which writes data/daemon.env for you.
#
#   mkdir -p data
#   cp data/daemon.env.example data/daemon.env
#   # fill DAEMON_TOKEN + DAEMON_NODE_ID from the panel, then start the daemon

DAEMON_TOKEN=
DAEMON_NODE_ID=
DAEMON_PORT=8081
DAEMON_HOST=0.0.0.0
DATA_DIR=./data
PUBLIC_HOST=node1.example.com
PUBLIC_IP=
PANEL_URL=https://panel.example.com
SFTP_PORT=2022
SFTP_ENABLED=true
DOCKER_IMAGE=eclipse-temurin:25-jre-jammy
# Game container Docker json-file log rotation
# DOCKER_LOG_MAX_SIZE=10m
# DOCKER_LOG_MAX_FILE=3
# Game container networks: shared (default) or per_server
# DOCKER_NETWORK_MODE=shared
MYSQL_ROOT_PASSWORD=
MYSQL_PORT=3306
MYSQL_IMAGE=mysql:8.4
# Short-lived HS256 JWTs signed with DAEMON_TOKEN (Wings-style).
DAEMON_JWT_TTL=900
DAEMON_JWT_WS_TTL=3600
DAEMON_JWT_LEGACY=false
# Prometheus scrape (same as panel .env). Unset = localhost-only for GET /metrics.
# METRICS_TOKEN=
# Optional Sentry (daemon)
# SENTRY_DSN=